# Copy to .env.local for development. NEVER commit real values — this repo is public.
# In production (AWS Amplify) set these as app environment variables; the build
# copies them into the SSR runtime (scripts/write-runtime-env.mjs).

# ── Core ─────────────────────────────────────────────────────────────────────
# Use a Neon *development branch* locally, never the production database.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Media storage (S3) ───────────────────────────────────────────────────────
# On Amplify, credentials come from the app's IAM compute role — no keys needed.
MEDIA_BUCKET=
MEDIA_REGION=eu-west-2
# Optional: CDN in front of the bucket
MEDIA_PUBLIC_URL=
# Legacy fallback only (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# ── Email (AWS SES) ──────────────────────────────────────────────────────────
SES_REGION=eu-west-2
SES_FROM_EMAIL=AwehChat <noreply@awehchat.co.za>
# Only for local development; Amplify uses the compute role
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Alternative sender (used instead of SES when set): https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Moswords <noreply@awehchat.co.za>

# ── Admin MFA ────────────────────────────────────────────────────────────────
# openssl rand -hex 32  (64 hex chars)
MFA_ENCRYPTION_KEY=

# ── Calls (optional: LiveKit group calls; 1:1 calls use WebRTC directly) ────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
NEXT_PUBLIC_TURN_URL=

# ── Optional services ────────────────────────────────────────────────────────
GOOGLE_GENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GIPHY_API_KEY=

# Ecosystem apps no longer use shared master keys: issue each app its own
# scoped key on /ecosystem (stored hashed). See docs/ECOSYSTEM_API.md.
