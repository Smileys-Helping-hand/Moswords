# ============================================
# CORE CONFIGURATION
# ============================================

# Database Configuration
DATABASE_URL=postgresql://user:password@host/database

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://yourdomain.com

# ============================================
# EMAIL & AWS SES CONFIGURATION
# ============================================
# Required for MFA email codes and NexusMail dispatch

# AWS SES Region (e.g., af-south-1, eu-west-1, us-east-1)
AWS_REGION=af-south-1

# AWS IAM Credentials with SES permissions
# Get these from AWS IAM console
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Verified SES sender email (must be verified in AWS SES)
AWS_SES_FROM_EMAIL=noreply@awechat.co.za

# ============================================
# MFA ENCRYPTION
# ============================================
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
MFA_ENCRYPTION_KEY=your_32_byte_hex_key_here

# ============================================
# EXTERNAL APP MASTER API KEYS
# ============================================
# These are used for inter-app communication
# Each key belongs to a specific application in your ecosystem

# Nexus platform
NEXUS_API_KEY=601a699f41445939e101d9d642f3b0386602f225451d972611f972f284a40f6c

# AweChat application
AWECHAT_API_KEY=a7f2e9c4d1b8f3a6e5c2d9f1a4b7e0c3

# Consolidated Hub dashboard
CONSOLIDATED_HUB_API_KEY=mak_7f8b9e2c1a5d3f6e4b9c2a8d5f1e3a7c

# Axion system
AXION_API_KEY=axm_5a964afe59e6bb741257ff492b063960

# Finance Play app
FINANCE_PLAY_API_KEY=SB-8f3d4e6a2c9b7f1e5d3a8c2b6f9e1d4a7c3b5f2e8d9a6c1b4e7f3d8a2c5b

# ============================================
# SECOND BRAIN INTEGRATION
# ============================================
# Central hub for connected applications

SECOND_BRAIN_API_KEY=5d50b3e58d586060470a26e56a8f973b22334ed0fe85d6b6c1105b3e3cf997d8

# Development: http://localhost:4000
# Production: https://savestate.co.za
SECOND_BRAIN_API_URL=https://savestate.co.za

# ============================================
# OPTIONAL SERVICES
# ============================================

# Google AI Configuration
GOOGLE_GENAI_API_KEY=your_google_ai_api_key_here

# OAuth Providers (if using)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
