<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Production: only HTTPS is allowed (base-config below).
        Debug builds: also allow cleartext to the local dev server.
    -->

    <!-- Local dev server (only used in debug builds) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>       <!-- Android emulator → host machine -->
        <domain includeSubdomains="true">192.168.31.217</domain>  <!-- Your dev machine on LAN -->
        <domain includeSubdomains="true">192.168.0.0</domain>     <!-- Generic LAN range -->
    </domain-config>

    <!-- All other traffic: HTTPS only, trust system CA + user-installed CAs for dev -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
