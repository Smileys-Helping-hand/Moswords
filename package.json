{
  "name": "moswords",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "node scripts/update-version.js && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/seed.ts",
    "db:dedupe-friends": "tsx src/lib/dedupe-friends.ts",
    "mobile:sync": "npx cap sync",
    "mobile:sync:dev": "node -e \"const fs=require('fs');const bak=fs.readFileSync('capacitor.config.ts','utf8');try{fs.copyFileSync('capacitor.config.dev.ts','capacitor.config.ts');require('child_process').execSync('npx cap sync',{stdio:'inherit'})}finally{fs.writeFileSync('capacitor.config.ts',bak,'utf8')}\"",
    "mobile:sync:prod": "npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:run:android": "npx cap run android",
    "mobile:run:android:dev": "npx cap run android",
    "build:mobile": "next build && npx cap sync",
    "apk:debug": "npx cap sync && cd android && .\\gradlew.bat assembleDebug && cd .. && copy android\\app\\build\\outputs\\apk\\debug\\app-debug.apk apk\\Moswords.apk",
    "apk:release": "npx cap sync && cd android && .\\gradlew.bat assembleRelease && cd .. && copy android\\app\\build\\outputs\\apk\\release\\app-release.apk apk\\Moswords-release.apk",
    "apk:release:unix": "npx cap sync && cd android && ./gradlew assembleRelease && cd .. && cp android/app/build/outputs/apk/release/app-release.apk apk/Moswords-release.apk",
    "aab:release": "npx cap sync && cd android && .\\gradlew.bat bundleRelease",
    "aab:release:unix": "npx cap sync && cd android && ./gradlew bundleRelease",
    "keystore:create": "keytool -genkeypair -v -keystore android/keystore/moswords-release.keystore -alias moswords -keyalg RSA -keysize 2048 -validity 10000",
    "keystore:verify": "keytool -list -v -keystore android/keystore/moswords-release.keystore"
  },
